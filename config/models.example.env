# Local MLX model / server preferences.
# Copy to config/models.env (gitignored) or let the bootstrap script create it.
# Bootstrap seeds MLX_DEFAULT_MODEL and MLX_RECOMMENDED_CONTEXT from the composed
# profile (RAM tier + chip throughput + thermal class). Rebuild never overwrites
# an existing models.env — run `make recommend` after moving this clone to another Mac.
#
# Comments here are guidance only. The source of truth is scripts/lib/common.sh.
# Toolkit scripts parse MLX_* KEY=value lines and do not execute this file.
# Do not put secrets (HF_TOKEN) here.
#
# Real unified-memory use ≈
#   model weights + KV cache + runtime allocations + macOS/system memory
# Do not treat on-disk model file size as total RAM consumption.
# RAM is the OOM fence; chip class is the performance fence.

# Default chat / generation model (mlx-community preferred)
MLX_DEFAULT_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit

# Optional larger model for high-memory / fast-bandwidth machines (override manually)
# MLX_DEFAULT_MODEL=mlx-community/Mistral-7B-Instruct-v0.3-4bit

# Generation defaults (conservative for 8 GB)
MLX_MAX_TOKENS=256
MLX_TEMPERATURE=0.7

# Persistent server (mlx_lm.server)
MLX_SERVER_HOST=127.0.0.1
MLX_SERVER_PORT=8080

# Composed context default (tokens). Enforce in mlx_lm.generate --max-kv-size
# and mlx_lm.server --max-kv-size when that flag exists. 8 GB / fanless Air: 2048.
MLX_RECOMMENDED_CONTEXT=2048

# Opt-in text-to-image (mflux). Install with: make install-image
# Uncomment to override composed defaults from scripts/generate-mlx-image.sh
# MLX_IMAGE_FAMILY=flux2
# MLX_IMAGE_MODEL=flux2-klein-4b
# MLX_IMAGE_QUANTIZE=4
# MLX_IMAGE_STEPS=4
# MLX_IMAGE_WIDTH=512
# MLX_IMAGE_HEIGHT=512
# MLX_IMAGE_LOW_RAM=1
# MLX_IMAGE_SEED=42

# Opt-in text-to-video (mlx-video). Install with: make install-video
# Wan2.1 1.3B also needs: scripts/prepare-mlx-video-wan.sh
# Uncomment to override composed defaults from scripts/generate-mlx-video.sh
# MLX_VIDEO_FAMILY=wan21
# MLX_VIDEO_MODEL=wan21-t2v-1.3b-q4
# MLX_VIDEO_MODEL_DIR=
# MLX_VIDEO_MODEL_REPO=prince-canuma/LTX-2-distilled
# MLX_VIDEO_WIDTH=832
# MLX_VIDEO_HEIGHT=480
# MLX_VIDEO_FRAMES=17
# MLX_VIDEO_STEPS=10
# MLX_VIDEO_TILING=auto
# MLX_VIDEO_LTX_PIPELINE=distilled
# MLX_VIDEO_IMAGE=
# MLX_VIDEO_SEED=42
