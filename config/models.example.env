# Local MLX model / server preferences.
# Copy to config/models.env (gitignored) or let the bootstrap script create it.
#
# Real unified-memory use ≈
#   model weights + KV cache + runtime allocations + macOS/system memory
# Do not treat on-disk model file size as total RAM consumption.

# Default chat / generation model (mlx-community preferred)
MLX_DEFAULT_MODEL=mlx-community/Llama-3.2-3B-Instruct-4bit

# Optional larger model for high-memory machines (override manually)
# MLX_DEFAULT_MODEL=mlx-community/Mistral-7B-Instruct-v0.3-4bit

# Generation defaults (conservative for 8 GB)
MLX_MAX_TOKENS=256
MLX_TEMPERATURE=0.7

# Persistent server (mlx_lm.server)
MLX_SERVER_HOST=127.0.0.1
MLX_SERVER_PORT=8080

# Context guidance (soft; enforce in your client prompts / server flags as supported)
# 8 GB: keep short. Raise only when you have headroom after weights + OS.
MLX_RECOMMENDED_CONTEXT=2048
